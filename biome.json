{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/dist-demo",
			"!**/dist-site",
			"!**/test-results",
			"!**/playwright-report",
			"!ui/test/fake-api/*.json",
			"!ui/demo/library.json",
			"!ui/src/shared/api/fooJeanSchema.d.ts",
			"!pnpm-lock.yaml"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"domains": {
			"react": "recommended"
		},
		"rules": {
			"preset": "recommended",
			"correctness": {
				"useExhaustiveDependencies": "warn"
			},
			"style": {
				"noNonNullAssertion": "off",
				"useNamingConvention": "off"
			},
			"suspicious": {
				"noConsole": {
					"level": "error",
					"options": {
						"allow": ["warn", "error"]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["ui/src/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@tanstack/react-hotkeys",
											"@tanstack/react-hotkeys/**",
											"@tanstack/hotkeys",
											"@tanstack/hotkeys/**"
										],
										"message": "The hotkeys library is reached through shared/keyboard alone. Declare a binding in keymap.ts and register it with useKeymap, so the shortcut sheet and the keys cannot drift apart."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["ui/src/shared/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/domain/**", "@/features/**", "@/app/**"],
										"message": "shared/ knows nothing about the rest of the app. Invert the dependency: take what you need as an argument."
									},
									{
										"group": [
											"@tanstack/react-hotkeys",
											"@tanstack/react-hotkeys/**",
											"@tanstack/hotkeys",
											"@tanstack/hotkeys/**"
										],
										"message": "The hotkeys library is reached through shared/keyboard alone. Declare a binding in keymap.ts and register it with useKeymap, so the shortcut sheet and the keys cannot drift apart."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["ui/src/shared/keyboard/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/domain/**", "@/features/**", "@/app/**"],
										"message": "shared/ knows nothing about the rest of the app. Invert the dependency: take what you need as an argument."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["ui/src/domain/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/features/**", "@/app/**"],
										"message": "domain/ is below features/. A domain slice that needs a view belongs in features/."
									},
									{
										"group": [
											"@tanstack/react-hotkeys",
											"@tanstack/react-hotkeys/**",
											"@tanstack/hotkeys",
											"@tanstack/hotkeys/**"
										],
										"message": "The hotkeys library is reached through shared/keyboard alone. Declare a binding in keymap.ts and register it with useKeymap, so the shortcut sheet and the keys cannot drift apart."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["ui/src/features/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/app/**"],
										"message": "features/ is below app/. The shell composes features, never the other way round."
									},
									{
										"group": [
											"@tanstack/react-hotkeys",
											"@tanstack/react-hotkeys/**",
											"@tanstack/hotkeys",
											"@tanstack/hotkeys/**"
										],
										"message": "The hotkeys library is reached through shared/keyboard alone. Declare a binding in keymap.ts and register it with useKeymap, so the shortcut sheet and the keys cannot drift apart."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"ui/test/**",
				"ui/scripts/**",
				"ui/vite.config.ts",
				"ui/demo/build.ts",
				"site/build.ts",
				"site/test/**"
			],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					},
					"correctness": {
						"noUnusedFunctionParameters": "off"
					}
				}
			}
		}
	]
}
