{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!dist",
			"!dist-demo",
			"!dist-site",
			"!test-results",
			"!playwright-report",
			"!test/fake-api/*.json",
			"!demo/library.json",
			"!src/shared/api/fooJeanSchema.d.ts",
			"!pnpm-lock.yaml"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"domains": {
			"react": "recommended"
		},
		"rules": {
			"preset": "recommended",
			"correctness": {
				"useExhaustiveDependencies": "warn"
			},
			"style": {
				"noNonNullAssertion": "off",
				"useNamingConvention": "off"
			},
			"suspicious": {
				"noConsole": {
					"level": "error",
					"options": {
						"allow": ["warn", "error"]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/shared/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/domain/**", "@/features/**", "@/app/**"],
										"message": "shared/ knows nothing about the rest of the app. Invert the dependency: take what you need as an argument."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/domain/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/features/**", "@/app/**"],
										"message": "domain/ is below features/. A domain slice that needs a view belongs in features/."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/features/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/app/**"],
										"message": "features/ is below app/. The shell composes features, never the other way round."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"test/**",
				"scripts/**",
				"vite.config.ts",
				"demo/build.ts",
				"site/build.ts"
			],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					},
					"correctness": {
						"noUnusedFunctionParameters": "off"
					}
				}
			}
		}
	]
}
