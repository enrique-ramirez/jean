{
	"name": "jean",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.20.0",
	"scripts": {
		"dev": "pnpm --filter @jean/ui run dev",
		"build": "pnpm --filter @jean/ui run build",
		"preview": "pnpm --filter @jean/ui run preview",
		"demo": "pnpm --filter @jean/ui run demo",
		"demo:preview": "pnpm --filter @jean/ui run demo:preview",
		"site": "pnpm --filter @jean/site run build",
		"site:preview": "pnpm --filter @jean/site run preview",
		"typecheck": "pnpm -r run typecheck",
		"types:api": "pnpm --filter @jean/contract run types:api",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"format": "biome format --write",
		"test": "pnpm test:unit && pnpm test:e2e",
		"test:unit": "pnpm -r run test:unit",
		"test:e2e": "pnpm --filter @jean/ui run test:e2e",
		"test:ui": "pnpm --filter @jean/ui run test:ui",
		"fake": "pnpm --filter @jean/ui run fake",
		"perf": "pnpm --filter @jean/ui run perf",
		"test:live": "pnpm --filter @jean/ui run test:live",
		"test:contract": "pnpm --filter @jean/contract run test:conformance",
		"sync-kit": "\"${AI_ENGINEERING:-../ai-engineering}/bin/install.sh\" . --mode copy --force"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:"
	}
}
