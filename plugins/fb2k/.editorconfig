root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

# MSBuild files, and the .sln, which Visual Studio rewrites with tabs whether or
# not anyone asks it to.
[*.{vcxproj,targets,props}]
indent_size = 2

[*.sln]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

# Not ours to reformat.
[third_party/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = unset
