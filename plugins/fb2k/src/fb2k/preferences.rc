// Fixed size: foobar2000 sizes a preferences page to the space the host window has and
// does not scroll it, so a page taller than the smallest window somebody might use is a
// page with content nobody can reach. Two pages rather than one for the same reason:
// everything together does not fit. IDD_PREFERENCES holds what is set once; IDD_PERMISSIONS
// holds what governs a request, as a child page.
//
// Dialog units are relative to FONT 8, "MS Shell Dlg"; changing either invalidates every
// coordinate below. A wrapping LTEXT needs more height than its lines add up to, or the
// text reads squeezed.
//
// "resource.h" is reached relative to this file, which is how rc.exe resolves a quoted
// include -- ResourceCompile does not inherit the C++ include directories.

#include <windows.h>

#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_PREFERENCES DIALOGEX 0, 0, 332, 195
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "", IDC_NETWORKING_GROUP, 7, 7, 318, 66
    LTEXT           "", IDC_PORT_LABEL, 14, 22, 32, 10
    EDITTEXT        IDC_PORT, 50, 20, 46, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "", IDC_BIND_LABEL, 14, 42, 32, 10
    EDITTEXT        IDC_BIND, 50, 40, 104, 14, ES_AUTOHSCROLL
    LTEXT           "", IDC_BIND_HINT, 14, 58, 304, 10

    GROUPBOX        "", IDC_ORIGINS_GROUP, 7, 77, 318, 53
    LTEXT           "", IDC_ORIGINS_HINT, 14, 89, 304, 10
    EDITTEXT        IDC_ORIGINS, 14, 101, 304, 24,
                    ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL

    GROUPBOX        "", IDC_STARTUP_GROUP, 7, 134, 318, 28
    CONTROL         "", IDC_OPEN_BROWSER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 146, 304, 10

    LTEXT           "", IDC_CONFIG_PATH, 7, 166, 318, 22
END

IDD_PERMISSIONS DIALOGEX 0, 0, 332, 229
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "", IDC_PERMISSIONS_GROUP, 7, 7, 318, 70
    CONTROL         "", IDC_CONTROL_PLAYBACK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
                    14, 20, 304, 10
    CONTROL         "", IDC_WRITE_PLAYLISTS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
                    14, 34, 304, 10
    CONTROL         "", IDC_CHANGE_OUTPUT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
                    14, 48, 304, 10
    CONTROL         "", IDC_STREAMING_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
                    14, 62, 304, 10

    GROUPBOX        "", IDC_FIELDS_GROUP, 7, 81, 318, 53
    LTEXT           "", IDC_FIELDS_HINT, 14, 93, 304, 10
    EDITTEXT        IDC_FIELDS, 14, 105, 304, 24,
                    ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL

    LTEXT           "", IDC_MAX_AUTOPLAYLISTS_LABEL, 14, 140, 110, 10
    EDITTEXT        IDC_MAX_AUTOPLAYLISTS, 128, 138, 40, 14, ES_AUTOHSCROLL | ES_NUMBER

    GROUPBOX        "", IDC_HOSTS_GROUP, 7, 157, 318, 65
    LTEXT           "", IDC_HOSTS_HINT, 14, 169, 304, 22
    EDITTEXT        IDC_HOSTS, 14, 193, 304, 24,
                    ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
END
