<?xml version="1.0" encoding="utf-8"?>
<!--
  foo_jean, built as an x64 foobar2000 component.

  Four things here are load-bearing and each fails in a way that does not name
  itself. README.md, "Build traps", says where each is enforced.

  1. pfc builds as "$(Configuration) FB2K" while every other SDK project builds as
     "$(Configuration)". Encoded as SetConfiguration metadata on the pfc
     ProjectReference below, which is why building this .vcxproj directly works.
  2. /d2notypeopt is mandatory on anything touching SDK classes.
  3. WTL and the static runtime (RuntimeLibrary) reach the compiler through
     Directory.Build.targets one directory up, never through /p:UseEnv=true.
  4. OutDir is set explicitly, because the build drives this .vcxproj directly and
     $(SolutionDir) is then undefined.

  x64 only. scripts/package.ps1 has where an x86 build would need to go in the
  archive, and why the top level is not it.
-->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{5CC3CAD8-D73A-4B04-989E-5492C568D105}</ProjectGuid>
    <RootNamespace>foo_jean</RootNamespace>
    <Keyword>Win32Proj</Keyword>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <CharacterSet>Unicode</CharacterSet>
    <!--
      v143 rather than the v142 the SDK's projects declare. build.ps1 also passes
      /p:PlatformToolset=v143 so the SDK builds at all; setting it here as well is
      what lets this project open and build in the IDE without that override.
    -->
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>

  <PropertyGroup>
    <OutDir>$(MSBuildThisFileDirectory)..\bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\obj\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>foo_jean</TargetName>
    <LinkIncremental Condition="'$(Configuration)'=='Debug'">true</LinkIncremental>
    <LinkIncremental Condition="'$(Configuration)'=='Release'">false</LinkIncremental>
    <!-- MSVC matches /external:I by path prefix, so "third_party/..." reached through the repo root counts too. -->
    <ExternalIncludePath>$(MSBuildThisFileDirectory)..\third_party;$(MSBuildThisFileDirectory)..\sdk;$(ExternalIncludePath)</ExternalIncludePath>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>fb2k/PCH.h</PrecompiledHeaderFile>
      <WarningLevel>Level3</WarningLevel>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <TreatAngleIncludeAsExternal>true</TreatAngleIncludeAsExternal>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <!--
        Three roots. src/ so our own headers are reached as "core/..." and
        "fb2k/..."; the repo root so vendored headers are reached as
        "third_party/..."; sdk/ so SDK headers are reached as
        <foobar2000/SDK/foobar2000.h>, which is how the SDK's own headers
        cross-include each other.
      -->
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory);$(MSBuildThisFileDirectory)..;$(MSBuildThisFileDirectory)..\sdk;$(MSBuildThisFileDirectory)..\third_party\opus\include;$(MSBuildThisFileDirectory)..\third_party\ogg\include;$(MSBuildThisFileDirectory)..\third_party\zlib;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!--
        CPPHTTPLIB_ZLIB_SUPPORT is defined once for the whole project, never per file:
        third_party/README.md has why. It makes cpp-httplib include <zlib.h>, which is what
        third_party\zlib is doing on the include path above.

        NOMINMAX drops the min and max macros <windows.h> defines. They arrive through the
        foobar2000 SDK and turn a bare std::min(a, b) into a C2589 plus a C2660 naming a
        line that is not the problem.
      -->
      <PreprocessorDefinitions>CPPHTTPLIB_ZLIB_SUPPORT;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- 4715: not all control paths return a value. The SDK treats it as an error and so do we. -->
      <TreatSpecificWarningsAsErrors>4715</TreatSpecificWarningsAsErrors>
      <!--
        Object files mirror the source directories rather than landing in one flat
        folder. core/ and fb2k/ are two halves of the same design and deliberately
        share names, so core\preferences.cpp and fb2k\preferences.cpp would otherwise
        both write preferences.obj and the second would silently win. The symptom is
        an LNK2001 naming functions you can see defined in a file you can see being
        compiled.
      -->
      <ObjectFileName>$(IntDir)%(RelativeDir)</ObjectFileName>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <SubSystem>Windows</SubSystem>
      <!--
        shared.dll is foobar2000's own; this is its import library. The SDK static
        libs arrive through ProjectReference. ws2_32 and bcrypt are not listed
        either: cpp-httplib carries a #pragma comment(lib) for the first and
        src/fb2k/config_file.cpp for the second, and listing them here as well
        would mean two places to keep in step.
      -->
      <AdditionalDependencies>$(MSBuildThisFileDirectory)..\sdk\foobar2000\shared\shared-$(Platform).lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <BasicRuntimeChecks>EnableFastChecks</BasicRuntimeChecks>
      <PreprocessorDefinitions>_DEBUG;_WINDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;_WINDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- Trap 2. Do not remove, and do not overwrite AdditionalOptions wholesale. -->
      <AdditionalOptions>/d2notypeopt %(AdditionalOptions)</AdditionalOptions>
      <StringPooling>true</StringPooling>
    </ClCompile>
    <Link>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
    </Link>
  </ItemDefinitionGroup>

  <!--
    src/core/ is the portable half: it must not see a foobar2000 header, and the
    precompiled header *is* the foobar2000 SDK. Compiling it without the PCH is
    what turns that rule from a convention into a build failure if it is broken.

    It also has to be this way round for every file that includes cpp-httplib:
    it includes <winsock2.h>, which must be seen before anything pulls in
    <windows.h>, and the SDK pulls in <windows.h>. Wrong order and the build fails
    deep inside Winsock with errors that mention none of this.
  -->
  <ItemGroup>
    <ClCompile Include="core\*.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <WarningLevel>Level4</WarningLevel>
    </ClCompile>
  </ItemGroup>

  <!--
    libopus and libogg, fetched by scripts/fetch-opus.ps1. Compiled straight into the DLL
    rather than through a library project of their own, because that would mean carrying a
    .vcxproj for somebody else's code and keeping it in step with their releases.

    Warnings off and no precompiled header: this is 139 C files we do not own, and the PCH
    is the foobar2000 SDK, which is C++. The object directory is flat and separate, which
    is safe only because no two of these share a basename. That is checked, and worth
    rechecking after a version bump.
  -->
  <ItemGroup>
    <ClCompile Include="..\third_party\opus\src\*.c;..\third_party\opus\celt\*.c;..\third_party\opus\silk\*.c;..\third_party\opus\silk\float\*.c;..\third_party\ogg\src\*.c"
               Exclude="..\third_party\opus\src\opus_demo.c;..\third_party\opus\src\repacketizer_demo.c;..\third_party\opus\src\opus_compare.c;..\third_party\opus\celt\opus_custom_demo.c">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <CompileAs>CompileAsC</CompileAs>
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <ObjectFileName>$(IntDir)codec\</ObjectFileName>
      <PreprocessorDefinitions>OPUS_BUILD;USE_ALLOCA;HAVE_LRINTF;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\third_party\opus;$(MSBuildThisFileDirectory)..\third_party\opus\include;$(MSBuildThisFileDirectory)..\third_party\opus\celt;$(MSBuildThisFileDirectory)..\third_party\opus\silk;$(MSBuildThisFileDirectory)..\third_party\opus\silk\float;$(MSBuildThisFileDirectory)..\third_party\ogg\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemGroup>

  <ItemGroup>
    <ClCompile Include="..\third_party\zlib\*.c">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <CompileAs>CompileAsC</CompileAs>
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <ObjectFileName>$(IntDir)zlib\</ObjectFileName>
    </ClCompile>
  </ItemGroup>

  <!--
    The three foobar2000 SDK helper sources input_helper needs. Each includes "StdAfx.h", which
    is foobar2000+atl.h and so ATL and WTL, and names "SDK/..." from the SDK's foobar2000 folder.
    No precompiled header and that folder on their own include path keep both out of every file
    under src/. Warnings off for the reason the Opus block gives.
  -->
  <ItemGroup>
    <ClCompile Include="..\sdk\foobar2000\helpers\input_helpers.cpp;..\sdk\foobar2000\helpers\readers.cpp;..\sdk\foobar2000\helpers\file_list_helper.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <ObjectFileName>$(IntDir)sdk_helpers\</ObjectFileName>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\sdk\foobar2000;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemGroup>

  <ItemGroup>
    <ClCompile Include="fb2k\PCH.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="fb2k\*.cpp" Exclude="fb2k\PCH.cpp;fb2k\decoder_source.cpp" />
    <!-- helpers\input_helpers.h names "SDK/..." from the SDK's foobar2000 folder too. -->
    <ClCompile Include="fb2k\decoder_source.cpp">
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\sdk\foobar2000;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemGroup>

  <!--
    The preferences page's dialog template. rc.exe reaches "resource.h" relative to
    the .rc itself, so ResourceCompile needs no include directories of its own. It
    must not be given them through /p:UseEnv=true either: that is trap 3 above, and
    rc.exe failing on winres.h is where it shows up first.

    This wildcard also matches fb2k\ui_assets.rc, which scripts\embed-ui.ps1 writes from ui\dist
    before scripts\build.ps1 invokes msbuild at all: MSBuild's own item globs are expanded once,
    when this project is parsed, so the file has to exist on disk before that happens rather
    than as a build step of its own. fb2k\ui_assets.cpp reads the table the same script writes
    beside it, and is already covered by the fb2k\*.cpp wildcard above.
  -->
  <ItemGroup>
    <ResourceCompile Include="fb2k\*.rc" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="core\*.h" />
    <ClInclude Include="fb2k\*.h" />
    <!-- doctest belongs to the test build, not the DLL. -->
    <ClInclude Include="..\third_party\*.h" Exclude="..\third_party\doctest.h" />
    <ClInclude Include="..\third_party\*.hpp" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Trap 1 lives here. pfc has "Debug FB2K" and "Release FB2K" configurations
      alongside plain "Debug" and "Release"; only the FB2K ones omit the pfc copies
      of crashHook and winFormatSystemErrorMessageHook that foobar2000_SDK.lib also
      defines. SetConfiguration is passed to the referenced project as a global
      property and overrides the Configuration inherited from this build, including
      one given on the msbuild command line.
    -->
    <ProjectReference Include="..\sdk\pfc\pfc.vcxproj">
      <Project>{ebfffb4e-261d-44d3-b89c-957b31a0bf9c}</Project>
      <SetConfiguration>Configuration=$(Configuration) FB2K</SetConfiguration>
    </ProjectReference>
    <ProjectReference Include="..\sdk\foobar2000\SDK\foobar2000_SDK.vcxproj">
      <Project>{e8091321-d79d-4575-86ef-064ea1a4a20d}</Project>
    </ProjectReference>
    <!-- Provides the exported entry point foobar2000 looks for when loading the DLL. -->
    <ProjectReference Include="..\sdk\foobar2000\foobar2000_component_client\foobar2000_component_client.vcxproj">
      <Project>{71ad2674-065b-48f5-b8b0-e1f9d3892081}</Project>
    </ProjectReference>
    <!--
      Deliberately absent: foobar2000_sdk_helpers and libPPUI. Of the helpers,
      only the three sources input_helper needs are compiled, in their own item
      group above, rather than the library built with ATL throughout; libPPUI is
      a list control library for UI this component does not draw. If the link
      starts asking for symbols, it will name them.
    -->
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
