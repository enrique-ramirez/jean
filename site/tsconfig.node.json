{
	"extends": "@jean/ui/tsconfig.base.json",
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "nodenext",
		"types": ["node"],

		// The build is run straight by `node`, which strips types rather than compiling
		// them: specifiers therefore have to name the real file, and anything that is not
		// pure erasable syntax has to be a compile error here rather than a crash at
		// `pnpm site`.
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"erasableSyntaxOnly": true,

		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
	},
	"include": ["build.ts", "embeds.ts", "labels.ts", "readme.ts", "test/*.ts"]
}
