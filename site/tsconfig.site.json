{
	"extends": "@jean/ui/tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,

		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.site.tsbuildinfo"
	},
	// The page's own script only. Everything else here runs in node and is checked by
	// `tsconfig.node.json`.
	"include": ["main.ts", "labels.ts"]
}
