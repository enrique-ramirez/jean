{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,

		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.site.tsbuildinfo"
	},
	// The page's own script only. Everything else under `site/` runs in node and is checked with
	// the other build scripts.
	"include": ["site/main.ts", "site/labels.ts"]
}
