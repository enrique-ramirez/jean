{
	"name": "@jean/ui",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"demo": "node demo/build.ts",
		"demo:preview": "vite preview --outDir dist-demo",
		"typecheck": "tsc -b",
		"test:unit": "node --import ./test/alias.ts --test \"test/unit/*.test.ts\"",
		"test:e2e": "playwright test",
		"test:ui": "playwright test --ui",
		"fake": "node test/fake-api/main.ts",
		"test:live": "playwright test --project=live"
	},
	"dependencies": {
		"@tanstack/react-hotkeys": "catalog:",
		"@tanstack/react-query": "catalog:",
		"@tanstack/react-virtual": "catalog:",
		"lucide-react": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@playwright/test": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	}
}
