{
	"name": "@jean/ui",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"demo": "node demo/build.ts",
		"demo:preview": "vite preview --outDir dist-demo",
		"typecheck": "tsc -b",
		"test:unit": "node --import ./test/alias.ts --test \"test/unit/*.test.ts\"",
		"test:e2e": "playwright test",
		"test:ui": "playwright test --ui",
		"fake": "node test/fake-api/main.ts --port 8880",
		"test:live": "playwright test --project=live"
	},
	"dependencies": {
		"@tanstack/react-hotkeys": "^0.10.0",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-virtual": "^3.14.10",
		"lucide-react": "^1.37.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@types/node": "^26.4.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.1",
		"typescript": "^7.0.2",
		"vite": "^8.2.2"
	}
}
