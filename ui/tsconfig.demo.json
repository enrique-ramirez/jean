{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"jsx": "react-jsx",
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"resolveJsonModule": true,

		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.demo.tsbuildinfo"
	},
	// The app, because the demo mounts it, and the *portable* half of the fake --
	// the half with no node in it. `server.ts` and `capture.ts` are deliberately
	// absent: if one of them is ever imported from here, this is
	// where it should fail.
	"include": [
		"demo",
		"src",
		"test/fake-api/http.ts",
		"test/fake-api/routes.ts",
		"test/fake-api/state.ts",
		"test/fake-api/playerOrder.ts",
		"test/fake-api/fooJean.ts",
		"test/fake-api/jlib.ts"
	],
	// The worker has its own scope below, and `build.ts` is node's.
	"exclude": ["demo/sw.ts", "demo/build.ts"]
}
