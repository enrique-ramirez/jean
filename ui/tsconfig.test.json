{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		// Specs drive a browser through Playwright and also import the fake
		// player's Node-side helpers, so both libs are in reach here.
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["node", "vite/client"],
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		// In Playwright, *naming* a fixture is how a test depends on it -- several
		// specs take `player` purely to get a fresh fake per test and never touch
		// it. The compiler cannot see that, and renaming them all to `_player`
		// would obscure the one thing the parameter is there to say.
		// `noUnusedLocals` stays on, so dead code in a test body is still caught.
		"noUnusedParameters": false,

		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo"
	},
	// `test/*.ts` is the measurement scripts, which import from src -- so this
	// scope keeps bundler resolution rather than the fake player's nodenext.
	"include": [
		"test/e2e",
		"test/live",
		"test/unit",
		"test/*.ts",
		"test/fake-api/**/*.ts",
		"src/shared/api/multiValue.ts",
		"src/shared/api/rating.ts",
		"src/shared/api/types.ts",
		"src/shared/api/fieldTable.ts",
